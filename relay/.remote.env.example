# 复制为 relay/.remote.env 并填真值(该真值文件已被 .gitignore 忽略)
# 全权握手密钥:足够长的随机串,例如 `openssl rand -hex 24`。
# 全权连接可用会话选择器跨项目恢复 —— 给你信任的客户端(Mac 本地镜像/桌面)。
ROKID_TOKEN=
# 可选:受限(sandbox)密钥。持此密钥的连接只能在 relay/sandbox 内跑,
# 不能切换到其他项目会话 —— 给低信任设备(眼镜)。留空则不启用双档。
ROKID_SANDBOX_TOKEN=
# 你的 ngrok 固定域名(不含协议),例如 abc.ngrok-free.dev
NGROK_DOMAIN=
